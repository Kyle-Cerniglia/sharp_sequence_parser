SEQUENCE
    DELAY 1
    MOUNT UNPARK
    MOUNT UNPARK
    DELAY 1
    STILL MODE
    SET COLOUR SPACE TO RAW16
    SET OUTPUT FORMAT TO "FITS files (*.fits)"
    LOAD PROFILE "C6H OSC"
    MOUNT CONNECT
    TARGETNAME "1_uvir"
    MOUNT GOTO "1 2 3, 4 5 6"
    DELAY 10
    PRESERVE CAMERA SETTINGS
        SET EXPOSURE TO 1
        SET GAIN TO 100
        MOUNT SOLVEANDSYNC
    END PRESERVE
    DELAY 10
    GUIDING CONNECT ABORT False
    GUIDING STOP
    DELAY 5
    GUIDING START
    DELAY 10
    COOL DOWN TO 1 RATE 8 TOLERANCE 1
    SET EXPOSURE TO 15
    PRESERVE CAMERA SETTINGS
        FRAMETYPE Light
        GUIDING DITHER EVERY 24 FRAMES
        CAPTURE 193 FRAMES REQUIREGUIDING True
        GUIDING DITHER EVERY STOP
    END PRESERVE
    GUIDING STOP
    GUIDING DISCONNECT

    MOUNT PARK
    SET COOLER OFF
END SEQUENCE
